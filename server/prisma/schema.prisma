generator client {
  provider        = "prisma-client"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  extensions = [btree_gist]
}

// ---------- Enums ----------

enum Role {
  EMPLOYEE
  MANAGER
  HR
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RequestEventAction {
  CREATED
  APPROVED
  REJECTED
  CANCELLED
  MODIFIED
}

enum BalanceAdjustmentType {
  ACCRUAL
  MANUAL_CORRECTION
  CARRYOVER
}

/// What an HR audit entry is about. EMPLOYEE added in RH-B1 (password resets);
/// a later phase will add BALANCE_ADJUSTMENT.
enum HrAuditEntity {
  DEPARTMENT
  LEAVE_TYPE
  HOLIDAY
  EMPLOYEE
}

/// PASSWORD_RESET: HR gave an employee a temporary password. Its snapshots
/// only hold mustChangePassword and passwordChangedAt, never the password.
enum HrAuditAction {
  CREATED
  UPDATED
  DEACTIVATED
  REACTIVATED
  DELETED
  PASSWORD_RESET
}

// ---------- Models ----------

// Added by hand in migration leave_type_limits_and_department_restrict:
// uq_departments_name_lower (unique ignoring case) and chk_departments_name_trimmed.
model Department {
  id   String @id @default(cuid())
  name String @unique

  users User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  role         Role     @default(EMPLOYEE)
  hireDate     DateTime @map("hire_date") @db.Date
  isActive     Boolean  @default(true) @map("is_active")

  /// true while the password is a temporary one set by HR: the API then only
  /// allows GET /auth/me, POST /auth/change-password and logout (403 otherwise).
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  /// Last time the password changed (own change or HR reset). Session tokens
  /// carry this value and requireAuth rejects any token that does not match,
  /// so changing the password ends every other session.
  passwordChangedAt  DateTime @default(now()) @map("password_changed_at")

  departmentId String?     @map("department_id")
  // Restrict: a department with employees (active or not) cannot be deleted;
  // the API answers 409 first, this is the second line of defense.
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  managerId     String? @map("manager_id")
  manager       User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports User[]  @relation("UserManager")

  leaveRequests      LeaveRequest[]      @relation("RequesterRequests")
  decidedRequests    LeaveRequest[]      @relation("DeciderRequests")
  requestEvents      RequestEvent[]      @relation("ActorEvents")
  balanceAdjustments BalanceAdjustment[] @relation("UserAdjustments")
  grantedAdjustments BalanceAdjustment[] @relation("GrantedByAdjustments")
  hrAuditLogs        HrAuditLog[]        @relation("HrAuditActor")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([departmentId])
  @@index([managerId])
  @@index([role])
  @@map("users")
}

// Added by hand in migration leave_type_limits_and_department_restrict:
// uq_leave_types_name_lower (unique ignoring case), chk_leave_types_name_trimmed
// and chk_leave_types_code_format (uppercase identifier).
model LeaveType {
  id                           String  @id @default(cuid())
  name                         String  @unique
  code                         String  @unique
  countsAgainstVacationBalance Boolean @default(true) @map("counts_against_vacation_balance")
  isActive                     Boolean @default(true) @map("is_active")
  // Most business days one request of this type may cover; null = no limit.
  // CHECK chk_leave_types_max_business_days_range (added by hand) keeps it in 1..366.
  maxBusinessDaysPerRequest    Int?    @map("max_business_days_per_request")

  leaveRequests      LeaveRequest[]
  balanceAdjustments BalanceAdjustment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("leave_types")
}

model LeaveRequest {
  id String @id @default(cuid())

  requesterId String @map("requester_id")
  requester   User   @relation("RequesterRequests", fields: [requesterId], references: [id], onDelete: Restrict)

  leaveTypeId String    @map("leave_type_id")
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  // Copy of leaveType.countsAgainstVacationBalance taken when the request was
  // created. Balances read this copy, so editing a leave type never changes
  // past balances. No default on purpose: the code must always set it.
  countsAgainstVacationBalance Boolean @map("counts_against_vacation_balance")

  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  businessDays Int      @map("business_days")
  reason       String?  @db.Text

  status LeaveRequestStatus @default(PENDING)

  deciderId    String?   @map("decider_id")
  decider      User?     @relation("DeciderRequests", fields: [deciderId], references: [id], onDelete: Restrict)
  // decider_id/decided_at must match status (CHECK chk_leave_requests_decision_matches_status,
  // added by hand in migration add_decision_consistency_check): both set for APPROVED/REJECTED,
  // both NULL for PENDING, both-or-neither for CANCELLED (an approved request cancelled by the
  // employee keeps its decider). Also chk_leave_requests_decider_not_requester.
  decidedAt    DateTime? @map("decided_at")
  decisionNote String?   @map("decision_note") @db.Text

  events RequestEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([requesterId])
  @@index([status])
  @@index([deciderId])
  @@index([leaveTypeId])
  // Supports the requester_id/start_date/end_date range query used by the
  // no-overlap EXCLUDE constraint added by hand in migration add_constraints
  // (Prisma cannot express a GiST EXCLUDE constraint in the schema).
  @@index([requesterId, startDate, endDate])
  @@map("leave_requests")
}

model RequestEvent {
  id String @id @default(cuid())

  leaveRequestId String       @map("leave_request_id")
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)

  actorId String? @map("actor_id")
  actor   User?   @relation("ActorEvents", fields: [actorId], references: [id], onDelete: Restrict)

  action RequestEventAction
  note   String?            @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([leaveRequestId])
  @@index([actorId])
  @@map("request_events")
}

// CHECK chk_holidays_name_trimmed added by hand (migration leave_type_limits_and_department_restrict).
model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("holidays")
}

model BalanceAdjustment {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation("UserAdjustments", fields: [userId], references: [id], onDelete: Restrict)

  leaveTypeId String?    @map("leave_type_id")
  leaveType   LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)

  type          BalanceAdjustmentType @default(MANUAL_CORRECTION)
  days          Int
  reason        String                @db.Text
  effectiveDate DateTime              @map("effective_date") @db.Date

  grantedById String? @map("granted_by_id")
  grantedBy   User?   @relation("GrantedByAdjustments", fields: [grantedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([effectiveDate])
  @@index([leaveTypeId])
  @@index([grantedById])
  @@map("balance_adjustments")
}

/// Append-only log of every change HR makes to the catalogs (and, from RH-B,
/// to employees and balances). Written in the same transaction as the change.
/// Never edited or deleted. Added by hand in migration hr_audit_log:
/// trg_hr_audit_logs_append_only (rejects UPDATE/DELETE), trg_hr_audit_logs_no_truncate
/// (rejects TRUNCATE unless the transaction sets app.allow_audit_truncate),
/// chk_hr_audit_logs_snapshots_match_action (before/after match the action;
/// replaced in migration audit_password_reset_check so PASSWORD_RESET needs
/// both sides), chk_hr_audit_logs_snapshots_are_objects (snapshots are JSON objects)
/// and chk_hr_audit_logs_password_reset_shape (PASSWORD_RESET: EMPLOYEE entity,
/// snapshots with exactly mustChangePassword and passwordChangedAt, after = temporary).
model HrAuditLog {
  id String @id @default(cuid())

  actorId String @map("actor_id")
  actor   User   @relation("HrAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  entityType HrAuditEntity @map("entity_type")
  /// No foreign key on purpose: the entity may be deleted (e.g. a department).
  entityId   String        @map("entity_id")
  action     HrAuditAction

  /// Whitelisted snapshot of the entity before / after the change (ISO dates,
  /// never secrets). NULL before CREATED and after DELETED.
  before Json?
  after  Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@index([createdAt])
  @@map("hr_audit_logs")
}
